<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/0.5.76-alpha">
  <PropertyGroup>
    <!-- Рабочая папка -->
    <WorkingDirectory>C:\Users\gimna\Desktop\BMSTU\MyProjects\bot\src\TelegramBOT\FlashscoreScraping</WorkingDirectory>
    <PackageJsonFile>$(WorkingDirectory)\package.json</PackageJsonFile>
    <!-- Указываем явно, что точка входа не app.js -->
    <StartProgram>npm</StartProgram>
    <StartArguments>run results</StartArguments>
    <StartupCommand>node app.js --all</StartupCommand>
    <StartupCommandWorkingDirectory>C:\Users\gimna\Desktop\BMSTU\MyProjects\bot\src\TelegramBOT\FlashscoreScraping</StartupCommandWorkingDirectory>
    <BuildCommand>npm install</BuildCommand>
    <BuildCommandWorkingDirectory>C:\Users\gimna\Desktop\BMSTU\MyProjects\bot\src\TelegramBOT\FlashscoreScraping</BuildCommandWorkingDirectory>
  </PropertyGroup>
  <ItemGroup>
    <JavaScriptDebugProfile Include="Results">
      <Command>npm</Command>
      <Arguments>run results</Arguments>
      <WorkingDirectory>$(WorkingDirectory)</WorkingDirectory>
    </JavaScriptDebugProfile>
    <JavaScriptDebugProfile Include="Calendar">
      <Command>npm</Command>
      <Arguments>run calendar</Arguments>
      <WorkingDirectory>$(WorkingDirectory)</WorkingDirectory>
    </JavaScriptDebugProfile>
    <JavaScriptDebugProfile Include="Start">
      <Command>npm</Command>
      <Arguments>start</Arguments>
      <WorkingDirectory>$(WorkingDirectory)</WorkingDirectory>
    </JavaScriptDebugProfile>
  </ItemGroup>
</Project>